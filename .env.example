APP_NAME=Squadex
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
AUTH_APP_URL=https://app.sqaudex.com
TOKEN_NAME="Squadex Token"
TOKEN_SYMBOL=SQX
TOKEN_PRICE=0.10

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

CACHE_PATH=/var/www/html/storage/framework/cache/data
CACHE_LOCK_PATH=/var/www/html/storage/framework/cache/data

MAIL_FROM_ADDRESS="hello@example.com"
PUBLIC_CONTACT_ADDRESS="hello@example.com"

PUBLIC_PROJECTION_CONTRACT_VERSION=v1
PUBLIC_PROJECTION_PATH=/var/www/html/storage/app/public-projections
PUBLIC_PROJECTION_CACHE_TTL=300
PUBLIC_PROJECTION_STALE_TTL=86400
PUBLIC_PROJECTION_MAX_SNAPSHOT_AGE=86400
PUBLIC_PROJECTION_MAX_BYTES=5242880
PUBLIC_PROJECTION_MAX_FILES=256
PUBLIC_PROJECTION_MAX_VARIANTS=1000
PUBLIC_TRUSTED_HOSTS=localhost
PUBLIC_TRUSTED_PROXIES=REMOTE_ADDR
PUBLIC_MEDIA_HOSTS=localhost

VITE_APP_NAME="${APP_NAME}"
